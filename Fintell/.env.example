# Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True

# Database
DATABASE_URL=sqlite:///erp_system.db
# For PostgreSQL: postgresql://user:password@localhost:5432/erp_db

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# SMTP (for email notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# SMS Gateway (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# TAX CABINET INTEGRATION (Uzbekistan)
TAX_CABINET_URL=https://cabinet.soliq.uz/api
TAX_API_KEY=your-tax-api-key-here
COMPANY_TIN=123456789012
COMPANY_NAME=Kompaniya Nomi
USE_DEV_TAX_API=True

# TELEGRAM BOT
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# OCR (Optical Character Recognition)
USE_DEV_OCR=True
TESSERACT_PATH=/usr/bin/tesseract  # Linux/Mac, Windows: C:\Program Files (x86)\Tesseract-OCR\tesseract.exe

